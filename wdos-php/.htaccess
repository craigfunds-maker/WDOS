# WDOS on Apache (cPanel shared hosting). Render gets the same rules from the Dockerfile.
Options -Indexes
RewriteEngine On
# private folders and files are never served
RewriteRule ^(lib|migrations|docs)(/|$) - [F,L]
RewriteRule ^(config\.local\.php|config\.sample\.php|Dockerfile|README-DEPLOY\.md|\.user\.ini)$ - [F,L]
# every /api/... request goes to the one PHP entry point
RewriteRule ^api(/.*)?$ api/index.php [QSA,L]
# the privacy notice has a short, stable address: /privacy
RewriteRule ^privacy/?$ privacy.html [L]
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|index\.html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # code, styles and texts: the browser asks the server each time (a quick "not changed" when nothing changed), so a
  # release is never hidden behind an old copy the browser kept on its own
  <FilesMatch "\.(js|css|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2
# the same limits where PHP runs as an Apache module (cPanel "PHP handler: DSO"); ignored elsewhere
<IfModule mod_php.c>
  php_value upload_max_filesize 20M
  php_value post_max_size 24M
  php_value memory_limit 256M
</IfModule>
<IfModule mod_php8.c>
  php_value upload_max_filesize 20M
  php_value post_max_size 24M
  php_value memory_limit 256M
</IfModule>
